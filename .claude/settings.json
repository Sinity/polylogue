{
  "env": {
    "POLYLOGUE_ARCHIVE_ROOT": "/tmp/polylogue-archive",
    "POLYLOGUE_FORCE_PLAIN": "1",
    "HYPOTHESIS_PROFILE": "ci",
    "POLYLOGUE_PYTEST_WORKERS": "2",
    "POLYLOGUE_PYTEST_BASETEMP_ROOT": "/tmp/polylogue-pytest"
  },
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(devtools:*)",
      "Bash(polylogue:*)",
      "Bash(polylogued:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-devtools.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python\" -m devtools.lane_stop_hook",
            "timeout": 30,
            "statusMessage": "Packaging lane handoff"
          }
        ]
      }
    ]
  }
}
