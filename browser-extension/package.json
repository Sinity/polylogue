{
  "name": "polylogue-browser-capture",
  "version": "0.3.0",
  "private": true,
  "description": "Polylogue browser extension for capturing web LLM sessions",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "validate": "node scripts/validate-manifest.mjs",
    "build": "node scripts/build.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:screenshots": "node --test scripts/screenshots.test.mjs",
    "sync-version": "node scripts/build.mjs --sync-only",
    "install:screenshot-browser": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^25.0.0",
    "playwright": "1.63.0",
    "vitest": "^3.0.0",
    "web-ext": "8.10.0"
  },
  "dependencies": {
    "@streamparser/json": "0.0.26",
    "js-sha256": "0.11.1"
  }
}
