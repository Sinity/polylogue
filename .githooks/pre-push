#!/usr/bin/env bash
# Seconds-long checks only: formatting and crate boundaries. Clippy and the
# test suite are heavy and run as agentctl jobs (`agentctl job start polylogue
# check`), which queue them against the rest of the machine's work.
set -euo pipefail
build_inputs=(Cargo.toml Cargo.lock flake.nix flake.lock rust-toolchain
    rust-toolchain.toml .cargo build.rs crates xtask)
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" =~ ^0+$ ]] && continue # branch deletion
    base="$remote_sha"
    if [[ "$base" =~ ^0+$ ]]; then
        base=$(git merge-base "$local_sha" refs/remotes/origin/master) || base=""
    fi
    if [[ -z "$base" || "$local_sha" != "$(git rev-parse HEAD)" ]] ||
        ! git diff --quiet "$base" "$local_sha" -- "${build_inputs[@]}"; then
        nix develop --command cargo fmt --all -- --check
        exec nix develop --command cargo run --locked -q -p xtask -- boundaries
    fi
done
echo "pre-push: no Rust build inputs changed; skipping the fast check."
