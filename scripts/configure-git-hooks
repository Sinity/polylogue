#!/usr/bin/env bash
set -euo pipefail

# Resolve product hooks from the shared checkout, and pin only this checkout.
_polylogue_common_dir=$(git rev-parse --git-common-dir 2>/dev/null || true)
if [ -z "$_polylogue_common_dir" ]; then
  exit 0
fi
case "$_polylogue_common_dir" in
  /*) ;;
  *) _polylogue_common_dir="$PWD/$_polylogue_common_dir" ;;
esac
_polylogue_common_dir=$(CDPATH= cd -- "$_polylogue_common_dir" && pwd -P)
_polylogue_common_root=$(CDPATH= cd -- "$_polylogue_common_dir/.." && pwd -P)
_polylogue_hooks_path="$_polylogue_common_root/.githooks"

# Read the exact scope that would be written. Effective values can mask a
# missing common anchor or an incorrect worktree override.
if [ "$(git config --local --get extensions.worktreeConfig || true)" != true ]; then
  git config --local extensions.worktreeConfig true
fi
if [ "$(git config --local --get core.hooksPath || true)" != "$_polylogue_hooks_path" ]; then
  git config --local core.hooksPath "$_polylogue_hooks_path"
fi
if [ "$(git config --worktree --get core.hooksPath || true)" != "$_polylogue_hooks_path" ]; then
  git config --worktree core.hooksPath "$_polylogue_hooks_path"
fi
