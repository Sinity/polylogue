{
    "artifact": "polylogue.archive.independent-falsification",
    "version": 1,
    "purpose": "One bounded gate for independent safety, semantic, query, and interaction evidence.",
    "slices": [
        {
            "id": "safety",
            "evidence": "docs/safety-case-v1.json",
            "oracle": "asset hazards and production recovery routes"
        },
        {
            "id": "semantics",
            "evidence": "docs/semantic-fidelity-v1.json",
            "oracle": "OriginSpec witnesses and raw construct negative space"
        },
        {
            "id": "query",
            "evidence": "tests/property/test_search_cursor_pagination_laws.py",
            "oracle": "reference ordering independent of cursor implementation"
        },
        {
            "id": "interaction",
            "evidence": "tests/unit/cli/test_interaction_oracles.py",
            "oracle": "declared command/capability/state/transition matrix"
        }
    ],
    "gate": "all four slices must run and pass; interaction is evaluated only after safety, semantics, and query pass",
    "required_result_fields": [
        "population",
        "sampling",
        "stable_refs",
        "versions",
        "blind_spots",
        "resource_measurements",
        "mutation_controls"
    ],
    "privacy": {
        "live_archives": "not opened",
        "payload_text": "never emitted",
        "refs": "repository-relative paths and stable case names"
    },
    "rerun": "devtools verify falsification --execute-safety --json --report .agent/reports/independent-falsification-v1.json"
}
