{
  "$defs": {
    "AuthorityEnvelope": {
      "additionalProperties": false,
      "description": "Attribution for one operation result.\n\nThe operation boundary creates this value once. Adapters only serialize it;\nthey must not reconstruct archive or daemon facts independently.",
      "properties": {
        "analyzed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyzed"
        },
        "archive_epoch": {
          "title": "Archive Epoch",
          "type": "string"
        },
        "degraded": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Degraded",
          "type": "array"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "generation_id": {
          "title": "Generation Id",
          "type": "string"
        },
        "matched": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched"
        },
        "request_scope_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Scope Fingerprint"
        },
        "result_scope_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Scope Fingerprint"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "server_identity": {
          "enum": [
            "daemon",
            "direct"
          ],
          "title": "Server Identity",
          "type": "string"
        },
        "tier_schema_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Tier Schema Versions",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "archive_epoch",
        "generation_id",
        "tier_schema_versions",
        "server_identity",
        "elapsed_ms"
      ],
      "title": "AuthorityEnvelope",
      "type": "object"
    },
    "QueryUnitAggregateRowPayload": {
      "additionalProperties": false,
      "description": "Grouped aggregate row over a terminal query-unit result set.",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "group_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group By"
        },
        "group_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Key"
        },
        "metrics": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metrics"
        },
        "unit": {
          "enum": [
            "message",
            "action",
            "block",
            "assertion",
            "file",
            "run",
            "observed-event",
            "context-snapshot",
            "delegation"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "count"
      ],
      "title": "QueryUnitAggregateRowPayload",
      "type": "object"
    }
  },
  "$id": "https://polylogue.dev/schemas/cli-output/query-unit-aggregate-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Grouped count envelope for explicit terminal query-unit aggregate pipelines such as `messages where text:timeout | group by role | count`. Shared by CLI JSON output, Python API, MCP, and daemon HTTP.\n\nGenerated from `polylogue.surfaces.payloads.QueryUnitAggregateEnvelope` by `devtools render cli-output-schemas`. Do not edit by hand.",
  "properties": {
    "authority": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorityEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Continuation"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/QueryUnitAggregateRowPayload"
      },
      "title": "Items",
      "type": "array"
    },
    "limit": {
      "title": "Limit",
      "type": "integer"
    },
    "mode": {
      "const": "query-unit-aggregate",
      "default": "query-unit-aggregate",
      "title": "Mode",
      "type": "string"
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Offset"
    },
    "offset": {
      "title": "Offset",
      "type": "integer"
    },
    "pipeline": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pipeline"
    },
    "pipeline_stages": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "properties": {
          "args": {
            "type": "object"
          },
          "field": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "session_scope",
              "sort",
              "limit",
              "offset",
              "group",
              "count",
              "agg",
              "transform",
              "terminal"
            ],
            "type": "string"
          },
          "metric": {
            "enum": [
              "count"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "predicate": {
            "type": "object"
          },
          "sort": {
            "type": "object"
          },
          "value": {
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "title": "Pipeline Stages",
      "type": "array"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "query_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query Ref"
    },
    "result_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Ref"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "unit": {
      "enum": [
        "message",
        "action",
        "block",
        "assertion",
        "file",
        "run",
        "observed-event",
        "context-snapshot",
        "delegation"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "unit",
    "query",
    "items",
    "total",
    "limit",
    "offset"
  ],
  "title": "Query Unit Aggregate Envelope",
  "type": "object",
  "x-polylogue-cli-surfaces": [
    "polylogue --format json find \"messages where ... | group by role | count\"",
    "Polylogue.query_units(...)",
    "MCP query_units",
    "GET /api/query-units?expression=..."
  ],
  "x-polylogue-source-model": "QueryUnitAggregateEnvelope"
}
