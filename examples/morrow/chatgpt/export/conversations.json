     "update_time": null,
     "content": {
      "content_type": "text",
      "parts": [
       "dateutil guesses month-first by default; chrono refuses ambiguous input."
      ]
     },
     "status": "finished_successfully",
     "end_turn": true,
     "weight": 1.0,
