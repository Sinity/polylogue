     "create_time": 1791140460.0,
     "update_time": null,
     "content": {
      "content_type": "text",
      "parts": [
       "03/04 is March 4 in the US and 3 April in most of Europe. Require an explicit locale or reject it."
      ]
     },
     "status": "finished_successfully",
     "end_turn": true,
     "weight": 1.0,
     "metadata": {
