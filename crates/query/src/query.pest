// The Polylogue query language,
// ported from the Python grammar to pest. Three shapes:
//
//   repo:polylogue since:7d "json envelope" -tag:stale
//   tool_calls where outcome:error | group by session | count
//   tag:project:morrow | tool_calls where action:shell
//
// Field names are checked against the field table after parsing, so the
// grammar accepts any identifier as a field. Each top-level shape carries
// its own end-of-input check, so an ordered choice that matched a prefix
// still backtracks to the next shape.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

query = { SOI ~ (unit_query ~ EOI | expr_query ~ EOI | EOI) }
// The same query read as conditions on sessions, for a first word that
// parsed as a unit but names none.
conditions_query = { SOI ~ expr_query ~ EOI }

// `messages where …`, or a bare unit selecting all its rows.
unit_query = { unit ~ (kw_where ~ expr)? ~ attach? ~ stages }
// Conditions on sessions, optionally followed by a scoped row query.
expr_query = { !(unit ~ kw_where) ~ expr ~ attach? ~ stages }

stages = { ("|" ~ stage)* }

// A unit name, plural or singular. Any identifier parses here; the parser
// resolves it through the unit registry (`Unit::from_name`), and a lone
// word that names no unit is searched as text instead.
unit = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* ~ !ident_char }

ident_char = _{ ASCII_ALPHANUMERIC | "_" | "-" | "." }

kw_where   = @{ ^"where" ~ !ident_char }
kw_between = @{ ^"between" ~ !ident_char }
kw_and_lc  = @{ ^"and" ~ !ident_char }
kw_with    = @{ ^"with" ~ !ident_char }
kw_AND     = @{ "AND" ~ !ident_char }
kw_OR      = @{ "OR" ~ !ident_char }
kw_NOT     = @{ "NOT" ~ !ident_char }
kw_exists  = @{ ^"exists" ~ !ident_char }
kw_seq     = @{ ^"seq" ~ !ident_char }

// Boolean conditions. Juxtaposition is AND; AND, OR and NOT are written in
// capitals so the lower-case words remain searchable.
expr     = { or_expr }
or_expr  = { and_expr ~ (kw_OR ~ and_expr)* }
and_expr = { not_expr ~ (kw_AND? ~ !stop ~ not_expr)* }
not_expr = { negate ~ not_expr | atom }
negate   = { kw_NOT | "-" }

// What may not start another juxtaposed condition.
stop = _{ kw_OR | kw_with ~ unit ~ "(" | "->" | "|" | ")" | "]" | "," | EOI }

atom = {
    "(" ~ expr ~ ")"
  | exists
  | seq
  | between
  | compare
  | url
  | position_ref
  | match_
  | text
}

exists = { kw_exists ~ unit ~ "(" ~ expr ~ ")" }

seq       = { kw_seq ~ "(" ~ step ~ (arrow ~ step)+ ~ ")" }
arrow     = { "->" ~ gap? }
gap       = { "[" ~ (gap_next | gap_within) ~ "]" }
gap_next  = { ^"next" }
gap_within = { ^"within:" ~ duration }
step      = { step_atom ~ (kw_AND? ~ !(stop) ~ step_atom)* }
step_atom = { "(" ~ expr ~ ")" | between | compare | match_ | text }

between = { field ~ kw_between ~ scalar ~ kw_and_lc ~ scalar }
compare = { field ~ op ~ scalar }
op      = @{ ">=" | "<=" | "!=" | ">" | "<" | "=" }
match_  = ${ field ~ ":" ~ mvalue }

mvalue       = ${ quoted | alternatives | any_value | bare }
alternatives = !{ "(" ~ bare ~ ("|" ~ bare)* ~ ")" }
any_value    = @{ "*" ~ !bare_char }

// A comparison or range value: a number, money, duration or time.
scalar      = { time_phrase | quoted | bare }
time_phrase = ${ (^"this" | ^"last") ~ " "+ ~ (^"week" | ^"month") ~ !ident_char }
duration    = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ ("ms" | "s" | "m" | "h" | "d" | "w") }

field = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_" | "-" | ".")* }

url          = @{ ("https://" | "http://") ~ bare_char+ }
position_ref = @{ "@" ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

text   = ${ quoted | word }
quoted = ${ "\"" ~ inner ~ "\"" }
inner  = @{ (!("\"" | "\\") ~ ANY | "\\" ~ ANY)* }
bare_char = _{ !(WHITESPACE | "(" | ")" | "|" | "\"" | "," | "[" | "]") ~ ANY }
bare   = @{ bare_char+ }
word   = @{ !(("AND" | "OR" | "NOT") ~ !ident_char) ~ !("-" | "->") ~ bare_char+ ~ call_args? }
// A pasted call: `weekday_offset()`, `parse(x)`. Its parts are searched.
call_args = @{ "(" ~ (!(")" | "(" | WHITESPACE | "\"") ~ ANY)* ~ ")" }

// Attached rows: `with messages(id, role)[role:assistant, last:1]`.
attach   = { kw_with ~ child ~ ("," ~ child)* }
child    = { unit ~ "(" ~ field ~ ("," ~ field)* ~ ")" ~ ("[" ~ window ~ ("," ~ window)* ~ "]")? }
window   = { window_n | expr }
window_n = ${ (^"first" | ^"last") ~ ":" ~ number }

// Pipeline stages.
stage = {
    sort_by | group_by | agg | count | limit | offset | where_stage
  | distinct | matches | measure | scope_stage
}
sort_by     = { ^"sort" ~ ^"by" ~ sort_key ~ direction? ~ ("," ~ sort_then)* }
// Later keys break ties left by earlier ones.
sort_then   = { field ~ direction? }
sort_key    = { random | field }
random      = { ^"random" ~ ("(" ~ number ~ ")")? }
direction   = { ^"asc" | ^"desc" }
group_by    = { ^"group" ~ ^"by" ~ group_key ~ ("," ~ group_key)* }
group_key   = { bucket ~ "(" ~ field ~ ")" | field }
bucket      = { ^"day" | ^"week" | ^"month" }
agg         = { ^"agg" ~ agg_fn ~ ("," ~ agg_fn)* }
agg_fn      = ${ agg_name ~ ":" ~ field | ^"count" ~ !ident_char }
agg_name    = @{ ^"sum" | ^"avg" | ^"min" | ^"max" | ^"count_distinct" | ^"p" ~ ASCII_DIGIT+ }
count       = { ^"count" ~ !ident_char }
limit       = { ^"limit" ~ number }
offset      = { ^"offset" ~ number }
where_stage = { kw_where ~ expr }
distinct    = { ^"distinct" ~ !ident_char }
matches     = { ^"matches" ~ !ident_char }
// `| measure WHAT`: a measurement over the sessions the query selects.
measure      = { ^"measure" ~ measure_what }
measure_what = @{ (ASCII_ALPHANUMERIC | "_" | "-" | ":")+ }
scope_stage = { unit ~ (kw_where ~ expr)? }
number      = @{ ASCII_DIGIT+ }
