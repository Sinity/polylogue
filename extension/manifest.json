{
  "manifest_version": 3,
  "name": "Polylogue",
  "version": "0.4.0",
  "description": "Saves your ChatGPT, Claude, Grok and Gemini conversations into Polylogue as they happen.",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Polylogue",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/chatgpt.js",
        "src/content/page.js",
        "src/wording.js",
        "src/content/panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/content/claude.js",
        "src/content/page.js",
        "src/wording.js",
        "src/content/panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/content/grok.js",
        "src/content/page.js",
        "src/wording.js",
        "src/content/panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/content/gemini.js",
        "src/content/page.js",
        "src/wording.js",
        "src/content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
