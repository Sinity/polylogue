{
  "content_version": "2026-09-15.declared-tools-r01",
  "recipes": [
    {
      "family": "continuity",
      "id": "resume-session",
      "intent": "Recover current work, failed effects, open loops, and a bounded next-step context without trusting a stale summary.",
      "prompts": [
        "resume_context"
      ],
      "queries": [
        {
          "declaration_id": "session-negated-tag",
          "expression": "repo:example-repo AND NOT tag:stale",
          "purpose": "Finds repository sessions that are not tagged stale.",
          "surface": "session"
        },
        {
          "declaration_id": "actions-unacknowledged-failures",
          "expression": "actions where session.repo:example-repo AND session.since:7d AND output:failed",
          "purpose": "Returns recent failed action evidence for one repository.",
          "surface": "terminal"
        }
      ],
      "query_declarations": [
        "session-negated-tag",
        "actions-unacknowledged-failures"
      ],
      "resources": [
        "polylogue://session/{id}",
        "polylogue://result-set/{id}"
      ],
      "steps": [
        {
          "arguments": {
            "include": [
              "identity",
              "coverage",
              "freshness",
              "readiness"
            ],
            "scope": "archive"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Establish which archive and source generations can support the answer.",
          "tool": "status"
        },
        {
          "arguments": {
            "expression": "repo:example-repo AND NOT tag:stale",
            "limit": 20,
            "projection": "session-summary"
          },
          "capture": "candidate_result_ref",
          "example_key": "session-negated-tag",
          "purpose": "Find likely unfinished sessions.",
          "tool": "query"
        },
        {
          "arguments": {
            "expression": "actions where session.repo:example-repo AND session.since:7d AND output:failed",
            "limit": 20,
            "projection": "action-evidence"
          },
          "capture": "failure_result_ref",
          "example_key": "actions-unacknowledged-failures",
          "purpose": "Find recent failed effects that may invalidate an optimistic handoff.",
          "tool": "query"
        },
        {
          "arguments": {
            "limit": 20,
            "ref": "polylogue://session/codex-session:demo-lineage-fork",
            "view": "chronicle"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Read the strongest candidate with evidence refs; continue until the needed boundary is reached.",
          "tool": "read"
        },
        {
          "arguments": {
            "budget_tokens": 4000,
            "intent": "resume",
            "result_ref": "result:0123456789abcdef01234567"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Compile a bounded resume packet from the selected result set and retain its receipt.",
          "tool": "context"
        }
      ],
      "title": "Resume a session from evidence"
    },
    {
      "family": "evidence",
