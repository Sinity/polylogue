          "capture": "aggregate_result_ref",
          "example_key": "aggregate-events-by-status",
          "purpose": "Measure failed versus successful tool-finished events.",
          "tool": "query"
        },
        {
          "arguments": {
            "expression": "actions where session.repo:example-repo AND session.since:7d AND output:failed",
            "limit": 20,
            "projection": "action-evidence"
          },
          "capture": "failure_result_ref",
          "example_key": "actions-unacknowledged-failures",
          "purpose": "Locate exact failed action refs.",
          "tool": "query"
        },
        {
          "arguments": {
            "projection": "evidence",
            "ref": "block:codex-session:demo-receipts:call-receipts-test-fail:0"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Resolve the exact cited failure block rather than quoting a search snippet.",
          "tool": "get"
        },
        {
          "arguments": {
            "limit": 20,
            "ref": "polylogue://session/codex-session:demo-receipts",
            "view": "chronicle"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Read the surrounding chronology and any recovery verification.",
          "tool": "read"
        }
      ],
      "title": "Perform a forensic lookup"
    },
    {
