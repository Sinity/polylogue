          "tool": "query"
        },
        {
          "arguments": {
            "expression": "files where session.repo:example-repo AND path:src/mcp/server.py",
            "limit": 20,
            "projection": "file-evidence"
          },
          "capture": "file_result_ref",
          "example_key": "files-repository-path",
          "purpose": "Find concrete edits under the relevant subsystem.",
          "tool": "query"
        },
        {
          "arguments": {
            "limit": 20,
            "ref": "result:0123456789abcdef01234567",
            "view": "ranked-evidence"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Read the retained result set rather than rerunning a changed query.",
          "tool": "read"
        },
        {
          "arguments": {
            "projection": "evidence",
            "ref": "message:codex-session:demo-lineage-fork:fork-a3"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Resolve the exact message containing the rationale selected from the result set.",
          "tool": "get"
        }
      ],
      "title": "Search prior art before changing a subsystem"
    },
    {
      "family": "authority",
      "id": "cost-audit",
      "intent": "Measure the declared cohort without mixing exact counters, estimates, missing coverage, or logical and physical grains.",
      "prompts": [
        "cost_of"
      ],
      "queries": [
        {
          "declaration_id": "sample-origin-cohort-window",
          "expression": "sessions where origin:(antigravity-session|hermes-session) AND date >= 2026-06-01",
          "purpose": "Selects a bounded origin cohort from a start date, the shape a cost audit measures.",
          "surface": "session"
        }
      ],
      "query_declarations": [
        "sample-origin-cohort-window"
      ],
      "resources": [
        "polylogue://result-set/{id}",
        "polylogue://session/{id}"
      ],
      "steps": [
        {
          "arguments": {
            "include": [
              "coverage",
              "freshness",
              "usage-counter-support"
            ],
            "scope": "sources"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Establish which origins have exact, partial, estimated, or absent usage evidence.",
          "tool": "status"
        },
        {
          "arguments": {
            "expression": "sessions where origin:(antigravity-session|hermes-session) AND date >= 2026-06-01",
            "limit": 50,
            "projection": "cost-rollup"
          },
          "capture": "cost_result_ref",
          "example_key": "sample-origin-cohort-window",
          "purpose": "Compute the requested cohort using declared cost semantics.",
          "tool": "query"
        },
        {
          "arguments": {
            "ref": "result:0123456789abcdef01234567",
            "subject": "result"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Inspect denominator, physical/logical grain, missing counts, estimate policy, and continuation state.",
          "tool": "explain"
        },
        {
          "arguments": {
            "limit": 50,
            "ref": "result:0123456789abcdef01234567",
            "view": "cost-evidence"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Read per-session evidence and continue through every exhaustive page required by the claim.",
          "tool": "read"
        },
        {
          "arguments": {
            "projection": "usage-provenance",
            "ref": "session:codex-session:demo-receipts"
          },
          "capture": null,
          "example_key": null,
          "purpose": "Resolve a representative source record when a counter or estimate is disputed.",
          "tool": "get"
        }
      ],
      "title": "Audit model/provider cost"
