#!/usr/bin/env bash
# polylogue-hook — AI coding agent hook handler for Polylogue
#
# Invoked by Claude Code, Codex, or Hermes hook systems on session lifecycle
# events. Receives the event type as the first argument and the event
# payload on stdin as JSON. Appends one newline-terminated JSON line to this
# process's own carrier under carriers/<provider>/<day>/<pid>.ndjson. The
# archive acquires that carrier's bytes like any other append-only source and
# materializes the events out of them; the producer does not fsync.
#
# Usage:
#   polylogue-hook <event-type> [--provider claude-code|codex|hermes] [--sidecar-dir PATH]
#
# --sidecar-dir is the concrete resolved spool path baked in by
# `polylogue hooks install` at install time (polylogue-o7hx): a hook
# subprocess's environment cannot be trusted to carry
# POLYLOGUE_ARCHIVE_ROOT (agent harnesses invoke hooks with their own,
# possibly minimal, environment), so ambient env resolution alone is not
# reliable here. Without --sidecar-dir, falls back to
# ${POLYLOGUE_ARCHIVE_ROOT:+$POLYLOGUE_ARCHIVE_ROOT/hooks} or the XDG
# default (byte-identical to the default archive root's hooks directory).
#
# Environment variables:
#   POLYLOGUE_ARCHIVE_ROOT  Overrides the archive root (and therefore the
#                           default sidecar directory) when --sidecar-dir
#                           is not given
#   POLYLOGUE_HOOK_PROVIDER Force provider (claude-code | codex | hermes)
#
# Supported events:
#   Claude Code (16): SessionStart, Setup, UserPromptSubmit, PreToolUse,
#     PostToolUse, PostToolUseFailure, PermissionRequest, PermissionDenied,
#     Notification, Elicitation, ElicitationResult, CwdChanged, FileChanged,
#     WorktreeCreate, SubagentStart, Stop
#   Codex (6): SessionStart, UserPromptSubmit, PreToolUse, PostToolUse,
#     PermissionRequest, Stop
#   Hermes (17, fs1.7 -- see polylogue/sources/parsers/hermes_lifecycle.py,
#     the single source of truth this list is kept in sync with):
#     model_attempt, model_failure, model_retry, model_fallback, tool_start,
#     tool_finish, tool_failure, tool_denial, approval_request,
#     approval_response, subagent_start, subagent_finish, compaction,
#     rewind, on_session_end, on_session_finalize, context_injected.
#     NOTE: this is Polylogue's PROTOTYPE consumer, wired against a
#     documented, testable event shape -- it is not confirmed to match a real
#     Hermes hook's actual invocation contract (no local checkout of the
#     Hermes hook source was available when this was written). Treat it as
#     the "working local Hermes prototype" handoff artifact for
#     docs/design/hermes-archival-export-contract.md, not a verified
#     integration. If the daemon or this script cannot keep up, the daemon's
#     file-watch fallback (LiveWatcher over the same carriers/ directory,
#     see tests/unit/sources/test_hook_spool.py) still drains anything
#     already written here.
#
# Exit codes:
#   0 - event recorded successfully
#   1 - input validation or processing error
#   2 - unsupported event type

set -euo pipefail

EVENT_TYPE="${1:-}"
if [ -z "$EVENT_TYPE" ]; then
    echo "Usage: polylogue-hook <event-type>" >&2
    exit 1
fi

shift
PROVIDER_ARG=""
SIDECAR_DIR_ARG=""
while [ "$#" -gt 0 ]; do
    case "${1:-}" in
        --provider)
            PROVIDER_ARG="${2:-}"
            case "$PROVIDER_ARG" in
                claude-code|codex|hermes) ;;
                *)
                    echo "polylogue-hook: --provider must be claude-code, codex, or hermes" >&2
                    exit 2
                    ;;
            esac
            shift 2
            ;;
        --sidecar-dir)
            SIDECAR_DIR_ARG="${2:-}"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# --sidecar-dir is the concrete resolved path baked in by `polylogue hooks
# install` at install time -- see the header comment (polylogue-o7hx). It
# takes precedence over ambient env resolution, which cannot be trusted in
# an agent harness's hook subprocess environment.
SIDECAR_DIR="${SIDECAR_DIR_ARG:-${POLYLOGUE_ARCHIVE_ROOT:+$POLYLOGUE_ARCHIVE_ROOT/hooks}}"
SIDECAR_DIR="${SIDECAR_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/polylogue/hooks}"

# Save stdin payload to a temp file so python3 can read it.
# The heredoc below consumes python's stdin for the script source.
PAYLOAD_FILE=$(mktemp)
trap 'rm -f "$PAYLOAD_FILE"' EXIT
cat > "$PAYLOAD_FILE"

python3 - "$EVENT_TYPE" "$SIDECAR_DIR" "$PAYLOAD_FILE" "$PROVIDER_ARG" <<'PYEOF'
import json
import os
import sys
from datetime import datetime, timezone

event_type = sys.argv[1]
sidecar_dir = sys.argv[2]
payload_path = sys.argv[3]
provider_arg = sys.argv[4] or None

# Supported events
CC_EVENTS = frozenset({
    "SessionStart", "Setup", "InstructionsLoaded", "UserPromptSubmit",
    "UserPromptExpansion", "MessageDisplay", "PreToolUse", "PermissionRequest",
    "PostToolUse", "PostToolUseFailure", "PostToolBatch", "PermissionDenied",
    "Notification", "SubagentStart", "SubagentStop", "TaskCreated", "TaskCompleted",
    "Stop", "StopFailure", "TeammateIdle", "ConfigChange", "CwdChanged",
    "FileChanged", "WorktreeCreate", "WorktreeRemove", "PreCompact", "PostCompact",
    "Elicitation", "ElicitationResult", "SessionEnd",
})
CODEX_EVENTS = frozenset({
    "SessionStart", "UserPromptSubmit", "PreToolUse",
    "PostToolUse", "PermissionRequest", "PreCompact", "PostCompact",
    "SubagentStart", "SubagentStop", "Stop",
})
# Kept in sync with polylogue.sources.parsers.hermes_lifecycle.HERMES_LIFECYCLE_EVENT_TYPES.
HERMES_EVENTS = frozenset({
    "model_attempt", "model_failure", "model_retry", "model_fallback",
    "tool_start", "tool_finish", "tool_failure", "tool_denial",
    "approval_request", "approval_response", "subagent_start", "subagent_finish",
    "compaction", "rewind", "on_session_end", "on_session_finalize", "context_injected",
})
ALL_EVENTS = CC_EVENTS | CODEX_EVENTS | HERMES_EVENTS

if provider_arg == "claude-code":
    allowed_events = CC_EVENTS
elif provider_arg == "codex":
    allowed_events = CODEX_EVENTS
elif provider_arg == "hermes":
    allowed_events = HERMES_EVENTS
else:
    allowed_events = ALL_EVENTS
if event_type not in allowed_events:
    print(f"polylogue-hook: unsupported event type: {event_type}", file=sys.stderr)
    sys.exit(2)

# Read and validate payload from the saved file
try:
    with open(payload_path, "r") as fh:
        payload = json.load(fh)
except (json.JSONDecodeError, FileNotFoundError) as e:
    print(f"polylogue-hook: invalid JSON payload: {e}", file=sys.stderr)
    sys.exit(1)

if not isinstance(payload, dict):
    print("polylogue-hook: payload must be a JSON object", file=sys.stderr)
    sys.exit(1)

# Extract session_id from payload
session_id = None
for key in ("session_id", "sessionId", "session"):
    val = payload.get(key)
    if isinstance(val, str) and val.strip():
        session_id = val.strip()
        break

if not session_id:
    print("polylogue-hook: could not extract session_id from payload", file=sys.stderr)
    sys.exit(1)

# Detect provider
provider = provider_arg or os.environ.get("POLYLOGUE_HOOK_PROVIDER")
if not provider:
    if event_type in HERMES_EVENTS and event_type not in (CC_EVENTS | CODEX_EVENTS):
        provider = "hermes"
    elif "turn_id" in payload:
        provider = "codex"
    elif "permission_mode" in payload or "model" in payload:
        provider = "claude-code"
    elif "source" in payload:
        provider = "codex"
    else:
        provider = "unknown"

if provider not in ("claude-code", "codex", "hermes"):
    print(
        "polylogue-hook: could not detect provider; "
        "pass --provider claude-code|codex|hermes",
        file=sys.stderr,
    )
    sys.exit(1)

# Event bodies are evidence (ids/hashes/timings/outcomes), never a second
# copy of message text -- mirrors polylogue.sources.hooks._reject_duplicated_transcript.
def _transcript_like_chars(value, depth=0):
    """Characters of string content under value, depth-capped (mirrors hook_producer)."""
    if isinstance(value, str):
        return len(value)
    if depth >= 6:
        return 0
    if isinstance(value, dict):
        return sum(_transcript_like_chars(item, depth + 1) for item in value.values())
    if isinstance(value, (list, tuple)):
        return sum(_transcript_like_chars(item, depth + 1) for item in value)
    return 0


for _key in ("text", "content", "transcript", "messages", "message_body", "reasoning"):
    _size = _transcript_like_chars(payload.get(_key))
    if _size > 2000:
        print(
            f"polylogue-hook: payload field {_key!r} looks like a duplicated transcript "
            f"({_size} chars) -- refusing to spool it",
            file=sys.stderr,
        )
        sys.exit(1)

# Build enriched event record
record = {
    "event_type": event_type,
    "session_id": session_id,
    "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "provider": provider,
    "payload": payload,
}

# Append one newline-terminated JSON line to this process's own carrier under
# carriers/<provider>/<day>/<pid>.ndjson. O_APPEND makes the seek-to-end and the
# write one atomic step, and only this process writes this carrier, so a short
# write can only ever be completed here. No tempfile, no rename, no fsync: the
# archive acquires the carrier's retained bytes like any other append-only
# source and materializes the events out of them, so the worst loss is a
# missing event, never a corrupt one.
import uuid

record["event_id"] = uuid.uuid4().hex
day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
carrier_dir = os.path.join(sidecar_dir, "carriers", provider, day)
os.makedirs(carrier_dir, exist_ok=True)
outfile = os.path.join(carrier_dir, f"{os.getpid()}.ndjson")
line = json.dumps(record, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
descriptor = os.open(outfile, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
try:
    written = 0
    while written < len(line):
        written += os.write(descriptor, line[written:])
finally:
    os.close(descriptor)
PYEOF
